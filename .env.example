# Copy to .env and fill in real values. See docs/environment-variables.md for
# what each variable is used for and whether it's required to boot.

PORT=3000

# MongoDB (required — app will not finish starting without a reachable instance)
MONGODB_URI=mongodb://localhost:27017/campus-bid

# Redis (required for cached reads on products/orders/notifications)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Email (Nodemailer, Gmail SMTP) — used for forgot/reset-password emails
EMAIL_USER=
EMAIL_PASS=

# Google OAuth - Users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/google/callback

# Google OAuth - Vendors (shares GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above)
GOOGLE_CALLBACK_URL_VENDOR=http://localhost:3000/api/vendors/google/callback

# Cloudinary
CLD_CLOUD_NAME=
CLD_API_KEY=
CLD_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Customer frontend's origin (used to build the Paystack payment callback URL,
# student password-reset links, and as the redirect target after customer Google OAuth)
APP_URL=http://localhost:5000

# Vendor frontend's origin (redirect target after vendor Google OAuth and
# the base of vendor password-reset links)
VENDOR_APP_URL=http://localhost:5002

# Admin frontend's origin (base of admin password-reset links)
ADMIN_APP_URL=http://localhost:5001

# Number of reverse proxies in front of the API (0 = none). Needed for per-client rate limiting behind a load balancer.
TRUST_PROXY_HOPS=0
